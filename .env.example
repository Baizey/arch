# Local runtime configuration
AGENT_CONSOLE_HOST=127.0.0.1
AGENT_CONSOLE_PORT=8420
ARCH_HOME=

OLLAMA_BASE_URL=http://localhost:11434

OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional web search providers
# At least 1 should be provided for web capabilities
BING_SEARCH_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# AgentSH sandbox containers.
# Arch always uses one AgentSH container per agent for shell execution.
AGENT_SANDBOX_DOCKER_COMMAND=docker
AGENT_SANDBOX_IMAGE=arch-agentsh:latest
AGENT_SANDBOX_API_KEY=sk-local-smoke-test
AGENT_SANDBOX_HOST_ROOT=C:\
AGENT_SANDBOX_CONTAINER_HOST_ROOT=/host
AGENT_SANDBOX_STATE_VOLUME_PREFIX=arch-agentsh
AGENT_SANDBOX_PORT_START=18080
AGENT_SANDBOX_PRIVILEGED=true
